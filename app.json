{
  "expo": {
    "name": "vacuna-registro",
    "slug": "vacuna-registro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.gob.salud.vacunaregistro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "mx.gob.salud.vacunaregistro",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Se necesita acceso a la cámara para escanear el código QR del paciente."
        }
      ],
      [
        "expo-brightness",
        {
          "locationWhenInUsePermission": "Se aumenta el brillo de la pantalla para facilitar el escaneo del QR."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007A6E",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b35f8171-4f33-4402-95d3-37634eccf990"
      }
    }
  }
}
